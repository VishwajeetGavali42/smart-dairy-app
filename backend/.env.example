# ==============================================================================
# SMART DAIRY: EXTERNAL SERVICES LIVE CREDENTIALS CONFIGURATION
# ==============================================================================
# Copy this file to '.env' or configure these environment variables in your deployment
# (e.g., Docker, Heroku, AWS, or local IDE run configuration).
#
# If left blank, the application automatically operates in safe, robust
# SANDBOX / MOCK mode (ideal for college defense, demos, offline development).
# When live keys are supplied, the backend seamlessly switches to LIVE CARRIER / CLOUD APIs.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SMS GATEWAY (Choose either FAST2SMS or TWILIO)
# ------------------------------------------------------------------------------
# Provider options: FAST2SMS (India Bulk SMS) | TWILIO (International)
SMS_ENABLED=true
SMS_PROVIDER=FAST2SMS
SMS_SENDER_ID=LDKDRY

# Fast2SMS Credentials (India - https://www.fast2sms.com)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio Credentials (Global - https://www.twilio.com)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# ------------------------------------------------------------------------------
# 2. CLOUD STORAGE (AWS S3)
# ------------------------------------------------------------------------------
# Used for storing farmer bills, milk receipts, and PDF reports in cloud buckets.
STORAGE_PROVIDER=AWS_S3
AWS_S3_BUCKET=smartdairy-storage-bucket
AWS_S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# ------------------------------------------------------------------------------
# 3. PUSH NOTIFICATIONS (Firebase Cloud Messaging - FCM)
# ------------------------------------------------------------------------------
# Used for dispatching shift summary alerts & rate change broadcasts to farmer Android apps.
FCM_ENABLED=true
FCM_SERVER_KEY=your_firebase_server_key_here
FCM_PROJECT_ID=smartdairy-fcm

# ------------------------------------------------------------------------------
# 4. LOCATION & ROUTE OPTIMIZATION (Google Maps API)
# ------------------------------------------------------------------------------
# Used for real-time milk tanker transit time & distance calculation from village centers to chilling plant.
# (If blank, mathematical Haversine formula is used automatically at zero cost).
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ------------------------------------------------------------------------------
# 5. SMTP EMAIL ALERTS
# ------------------------------------------------------------------------------
MAIL_ENABLED=true
MAIL_FROM=noreply@smartdairy.coop
